const express = require('express');
const axios = require('axios');
const cors = require('cors');

const app = express();
app.use(express.json());
app.use(cors());

const MERCADO_PAGO_TOKEN = "APP_USR-5776611800793273-101322-2513293431fd09c70bdb814756cefa07-318884679";

let clientesAtivos = [];

app.post('/criar-pix', async (req, res) => {
    const { valor, caixaId } = req.body;
    try {
        const response = await axios.post('https://api.mercadopago.com/v1/payments', {
            transaction_amount: parseFloat(valor),
            description: 'Venda Balcao - Frente de Caixa',
            payment_method_id: 'pix',
            payer: {
                email: 'vagner.caixa@email.com',
                first_name: 'Cliente',
                last_name: 'Pix'
            },
            external_reference: caixaId
        }, {
            headers: {
                'Authorization': `Bearer ${MERCADO_PAGO_TOKEN}`,
                'Content-Type': 'application/json'
            }
        });

        res.json({
            id_pagamento: response.data.id,
            qr_code: response.data.point_of_interaction.transaction_data.qr_code,
            qr_code_base64: response.data.point_of_interaction.transaction_data.qr_code_base64
        });
    } catch (error) {
        res.status(500).json({ error: 'Erro ao gerar o Pix' });
    }
});

app.get('/status-caixa/:caixaId', (req, res) => {
    const { caixaId } = req.params;
    res.setHeader('Content-Type', 'text/event-stream');
    res.setHeader('Cache-Control', 'no-cache');
    res.setHeader('Connection', 'keep-alive');
    clientesAtivos.push({ caixaId, res });
    req.on('close', () => {
        clientesAtivos = clientesAtivos.filter(p => p.res !== res);
    });
});

app.post('/webhook-mercado-pago', async (req, res) => {
    res.sendStatus(200);
    const { action, data } = req.body;
    if (action === "payment.created" || req.body.type === "payment") {
        const idPagamento = data ? data.id : req.body.data.id;
        try {
            const v = await axios.get(`https://api.mercadopago.com/v1/payments/${idPagamento}`, {
                headers: { 'Authorization': `Bearer ${MERCADO_PAGO_TOKEN}` }
            });
            if (v.data.status === 'approved') {
                const caixaId = v.data.external_reference;
                const cliente = clientesAtivos.find(c => c.caixaId === caixaId);
                if (cliente) {
                    cliente.res.write(`data: ${JSON.stringify({ status: 'PAGO' })}\n\n`);
                }
            }
        } catch (e) {
            console.error(e.message);
        }
    }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Rodando na porta ${PORT}`));
